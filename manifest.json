{
  "manifest_version": 3,
  "name": "Aura Accessibility Prototype",
  "version": "0.2.0",
  "description": "On-demand, local-first visual and reading support for web pages.",
  "minimum_chrome_version": "157",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_title": "Aura accessibility",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "aura-accessibility-prototype@example.local",
      "strict_min_version": "157.0"
    }
  }
}

